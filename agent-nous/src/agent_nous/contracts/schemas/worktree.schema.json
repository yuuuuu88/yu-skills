{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "worktree.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"$ref": "common.schema.json#/$defs/task_id"},
    "loop_id": {"type": "string", "minLength": 1},
    "contract_ref": {"type": "string", "minLength": 1},
    "action_id": {"type": "string", "minLength": 1},
    "branch": {"type": "string", "minLength": 1},
    "base_commit": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
    "worktree_path": {"type": "string", "minLength": 1},
    "worktree_identity": {"type": "string", "pattern": "^[0-9]+:[0-9]+$"},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"}
  },
  "required": ["schema_version", "task_id", "loop_id", "contract_ref", "action_id", "branch", "base_commit", "worktree_path", "worktree_identity", "created_at"]
}
