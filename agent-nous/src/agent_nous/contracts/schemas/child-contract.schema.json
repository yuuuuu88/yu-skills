{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "child-contract.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "contract_id": {"type": "string", "minLength": 1},
    "task_id": {"$ref": "common.schema.json#/$defs/task_id"},
    "loop_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "parent_loop_id": {"type": "string", "minLength": 1},
    "revision": {"$ref": "common.schema.json#/$defs/revision"},
    "previous_contract_ref": {"type": ["string", "null"]},
    "objective": {"type": "string", "minLength": 1},
    "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "non_goals": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "required_inputs": {"type": "array", "items": {"type": "string"}},
    "input_versions": {"type": "array", "items": {"type": "string"}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "properties": {"criterion_id": {"type": "string", "minLength": 1}, "statement": {"type": "string", "minLength": 1}, "validation_method": {"type": "string", "minLength": 1}}, "required": ["criterion_id", "statement", "validation_method"]}},
    "expected_outputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "resources": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z][a-z0-9+.-]*://.+"}, "uniqueItems": true},
    "write_scope": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9+.-]*://.+"}, "uniqueItems": true},
    "resource_contracts": {"type": "array", "minItems": 1, "items": {"$ref": "resource-contract.schema.json"}},
    "resource_requests": {"type": "array", "items": {"type": "object", "additionalProperties": false, "properties": {"resource_ref": {"type": "string"}, "requested_mode": {"enum": ["read", "write", "reserve", "external_effect"]}, "input_version_ref": {"type": ["string", "null"]}, "required_reservation": {"enum": ["shared_read", "exclusive_write", "exclusive_effect", "advisory"]}, "expected_change": {"type": "string"}, "integration_strategy": {"type": "string"}}, "required": ["resource_ref", "requested_mode", "input_version_ref", "required_reservation", "expected_change", "integration_strategy"]}},
    "risk_class": {"$ref": "common.schema.json#/$defs/risk"},
    "allowed_actions": {"type": "array", "items": {"type": "string"}},
    "forbidden_actions": {"type": "array", "items": {"type": "string"}},
    "preferred_backend": {"enum": ["sequential", "read_only_worker", "worktree"]},
    "integration_strategy": {"type": "string", "minLength": 1},
    "validation_plan": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "knowledge_references": {"type": "array", "items": {"type": "object", "additionalProperties": false, "properties": {"record_type": {"enum": ["question", "source", "claim"]}, "record_id": {"type": "string", "minLength": 1}, "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "required": ["record_type", "record_id", "content_hash"]}},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "required": ["schema_version", "contract_id", "task_id", "loop_id", "parent_loop_id", "revision", "previous_contract_ref", "objective", "scope", "non_goals", "dependencies", "required_inputs", "input_versions", "acceptance_criteria", "expected_outputs", "resources", "write_scope", "resource_contracts", "resource_requests", "risk_class", "allowed_actions", "forbidden_actions", "preferred_backend", "integration_strategy", "validation_plan", "knowledge_references", "created_at", "content_hash"]
}
