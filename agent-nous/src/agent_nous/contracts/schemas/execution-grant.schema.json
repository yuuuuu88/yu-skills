{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "execution-grant.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "grant_id": {"type": "string", "minLength": 1},
    "request_id": {"type": ["string", "null"]},
    "action_id": {"type": "string", "minLength": 1},
    "action_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "expected_state_revision": {"type": "integer", "minimum": 1},
    "actor": {"type": "string", "minLength": 1},
    "lease_token": {"type": "string", "minLength": 1},
    "issued_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "expires_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "single_use": {"const": true},
    "consumed": {"type": "boolean"},
    "consumed_at": {"anyOf": [{"$ref": "common.schema.json#/$defs/timestamp"}, {"type": "null"}]},
    "revocation_reason": {"type": ["string", "null"]},
    "policy_revision": {"const": "v1"},
    "loop_id": {"type": "string", "minLength": 1},
    "child_contract_ref": {"type": ["string", "null"]},
    "reservation_refs": {"type": "array", "items": {"type": "string"}},
    "worktree_ref": {"type": ["object", "null"]},
    "cleanup_target": {
      "type": ["object", "null"],
      "properties": {
        "loop_id": {"type": "string", "minLength": 1},
        "worktree_path": {"type": "string", "minLength": 1},
        "worktree_identity": {"type": "string", "pattern": "^[0-9]+:[0-9]+$"},
        "branch": {"type": "string", "minLength": 1}
      },
      "required": ["loop_id", "worktree_path", "worktree_identity", "branch"],
      "additionalProperties": false
    },
    "effective_scope": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "repository_root": {"type": "string", "minLength": 1},
        "repository_root_identity": {"type": "string", "minLength": 3},
        "targets": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "resource_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "command": {"type": ["array", "null"], "items": {"type": "string"}},
        "environment": {"type": "string", "minLength": 1},
        "network": {"const": false}
      },
      "required": ["repository_root", "repository_root_identity", "targets", "resource_ids", "command", "environment", "network"]
    },
    "approval_refs": {"type": "array", "items": {"type": "string"}},
    "policy_reason": {"type": "string"}
  },
  "required": ["schema_version", "grant_id", "request_id", "action_id", "action_digest", "expected_state_revision", "actor", "lease_token", "issued_at", "expires_at", "single_use", "consumed", "consumed_at", "revocation_reason", "policy_revision", "loop_id", "child_contract_ref", "reservation_refs", "worktree_ref", "cleanup_target", "effective_scope", "approval_refs", "policy_reason"]
}
