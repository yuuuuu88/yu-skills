{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "source",
    "fixture_version",
    "observations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source": {
      "const": "eval_runner_parent_capture"
    },
    "fixture_version": {
      "type": "string",
      "minLength": 1
    },
    "observations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/$defs/parent_capture"
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "parent_capture": {
      "type": "object",
      "required": [
        "source",
        "evidence_digest",
        "capability_observation"
      ],
      "properties": {
        "source": {
          "const": "eval_runner_parent_capture"
        },
        "evidence_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "capability_observation": {
          "type": "object",
          "required": [
            "task_id",
            "trace",
            "hidden_tests",
            "safety",
            "selected_capabilities",
            "research",
            "recovery",
            "parallel",
            "review",
            "scores"
          ],
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  }
}
