{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-observation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "observation_id": {"type": "string", "minLength": 1},
    "task_id": {"$ref": "common.schema.json#/$defs/task_id"},
    "loop_id": {"type": "string", "minLength": 1},
    "phase": {"const": "review"},
    "cycle": {"type": "integer", "minimum": 1},
    "reviewer_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["completed", "failed"]},
    "error": {"type": ["string", "null"]},
    "input_snapshot_digest": {"type": "string", "minLength": 1},
    "output_digest": {"type": ["string", "null"]},
    "output": {"type": ["object", "null"]},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"}
  },
  "required": [
    "schema_version",
    "observation_id",
    "task_id",
    "loop_id",
    "phase",
    "cycle",
    "reviewer_id",
    "status",
    "error",
    "input_snapshot_digest",
    "output_digest",
    "output",
    "created_at"
  ]
}
