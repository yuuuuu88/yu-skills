{
  "nous_home": "~/.local/share/nous",
  "engine": {
    "agents": {
      "plan": "python3 .nous/agents/plan.py",
      "implement": "python3 .nous/agents/implement.py",
      "review": "python3 .nous/agents/review.py"
    },
    "review": {
      "mode": "single",
      "fallback": "single"
    },
    "validation": {
      "allowed_processes": [
        [
          "/usr/bin/python3",
          "-m",
          "pytest"
        ]
      ]
    },
    "min_cycles": 1,
    "max_cycles": 10,
    "max_steps": 30,
    "lease_seconds": 600,
    "agent_timeout_seconds": 300,
    "resources": {
      "max_concurrent_agents": 3,
      "max_output_bytes": 4194304,
      "max_tool_calls": 100,
      "max_wall_seconds": 300
    },
    "durability": {
      "mode": "local"
    },
    "observability": {
      "trace_export_path": null,
      "max_event_bytes": 262144
    },
    "subagents": {
      "required": true,
      "mode": "external"
    },
    "subskills": {
      "enabled": true,
      "roots": [],
      "limit": 1,
      "role": "primary",
      "phase_capabilities": {
        "plan": [
          "plan.acceptance"
        ],
        "implement": [
          "implement.incremental"
        ],
        "review": [
          "review.independence"
        ]
      }
    },
    "research": {
      "enabled": true,
      "mode": "open_web_read_only",
      "public_https": true,
      "allow_domains": [
        "*"
      ],
      "blocked_private_networks": true,
      "allow_credentials": false,
      "allow_external_writes": false,
      "execute_downloads": false,
      "allowed_methods": [
        "GET",
        "HEAD"
      ],
      "allowed_ports": [
        443
      ],
      "max_requests": 50,
      "max_response_bytes": 10485760,
      "max_total_bytes": 52428800,
      "max_concurrent_requests": 4,
      "timeout_seconds": 30,
      "max_redirects": 5,
      "max_results": 20,
      "search_endpoint_template": "https://html.duckduckgo.com/html/?q={query}",
      "user_agent": "agent-nous-research/0.1"
    }
  }
}
